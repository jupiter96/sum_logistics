diff --git a/addon/components/modals/bulk-update-order-activity.js b/addon/components/modals/bulk-update-order-activity.js
new file mode 100644
index 0000000..60ac4bd
--- /dev/null
+++ b/addon/components/modals/bulk-update-order-activity.js
@@ -0,0 +1,290 @@
+import Component from '@glimmer/component';
+import { tracked } from '@glimmer/tracking';
+import { inject as service } from '@ember/service';
+import { action } from '@ember/object';
+import { task, all } from 'ember-concurrency';
+import { uniqueById, groupActivityOptions, partitionOrdersForGroup, isUsableCustomActivity, describeError } from '../../utils/bulk-order-activity';
+
+/**
+ * Requests in flight at once, for loading next activities and for applying the update.
+ */
+const CONCURRENCY = 5;
+
+const CUSTOM = 'custom';
+
+const STATE_CLASSES = {
+    pending: 'text-gray-500 dark:text-gray-400',
+    updating: 'text-blue-600 dark:text-blue-400',
+    updated: 'text-green-600 dark:text-green-400',
+    failed: 'text-red-600 dark:text-red-400',
+    skipped: 'text-yellow-700 dark:text-yellow-300',
+};
+
+/**
+ * Applies one activity to every selected order, the bulk counterpart of
+ * modals/update-order-activity.
+ *
+ * Each order offers only the activities its flow allows next, so the options are
+ * loaded per order and grouped by activity code; an option shows how many of the
+ * selected orders it applies to, and the orders it does not apply to are skipped.
+ * Updates go through the same `orders/update-activity/{id}` endpoint as the single
+ * order modal, a few at a time, and every order's outcome is listed with the
+ * server's error message when it fails.
+ *
+ * Options: `orders` (the selection), `onFinished(summary)` (called once the modal
+ * closes after any update was sent, including a close part way through).
+ */
+export default class ModalsBulkUpdateOrderActivityComponent extends Component {
+    @service fetch;
+    @service intl;
+    @service notifications;
+    @service modalsManager;
+
+    @tracked orders = [];
+    /** order id → { activities: Array, error: String|null } */
+    @tracked optionsByOrderId = {};
+    @tracked selectedKey = null;
+    @tracked customActivity = {};
+    @tracked bypassProof = false;
+    /** order id → { state: 'pending'|'updating'|'updated'|'failed'|'skipped', error: String|null } */
+    @tracked results = {};
+    /** 'select' | 'running' | 'done' */
+    @tracked phase = 'select';
+
+    hasStarted = false;
+
+    constructor(owner, { options = {} }) {
+        super(...arguments);
+        this.orders = uniqueById(options.orders);
+        this.loadOptions.perform();
+    }
+
+    willDestroy() {
+        super.willDestroy(...arguments);
+
+        if (!this.hasStarted) {
+            return;
+        }
+
+        const summary = this.summary;
+        if (this.phase === 'running') {
+            this.notifications.warning(this.intl.t('modals.bulk-order-activity.stopped', { done: summary.finished, total: summary.total }));
+        }
+
+        if (typeof this.args.options?.onFinished === 'function') {
+            this.args.options.onFinished(summary);
+        }
+    }
+
+    get loadPercent() {
+        return percentOf(Object.keys(this.optionsByOrderId).length, this.orders.length);
+    }
+
+    get activityGroups() {
+        const total = this.orders.length;
+
+        return groupActivityOptions(this.orders.map((order) => ({ id: order.id, activities: this.optionsByOrderId[order.id]?.activities }))).map((group, index) => ({
+            ...group,
+            radioId: `bulk_activity_${index}`,
+            isPartial: group.count < total,
+            isDispatch: group.activity?.code === 'dispatched',
+        }));
+    }
+
+    get loadFailures() {
+        return this.orders.filter((order) => this.optionsByOrderId[order.id]?.error).map((order) => ({ order, error: this.optionsByOrderId[order.id].error }));
+    }
+
+    get isCustom() {
+        return this.selectedKey === CUSTOM;
+    }
+
+    get selectedGroup() {
+        if (!this.selectedKey || this.isCustom) {
+            return null;
+        }
+
+        return this.activityGroups.find((group) => group.key === this.selectedKey) ?? null;
+    }
+
+    /**
+     * The orders the chosen activity is sent to, each with its own activity record, and
+     * the orders it skips. A custom activity is sent to every order.
+     */
+    get plan() {
+        if (this.isCustom) {
+            return { targets: this.orders.map((order) => ({ order, activity: this.customActivity })), skipped: [] };
+        }
+
+        if (!this.selectedGroup) {
+            return { targets: [], skipped: [] };
+        }
+
+        return partitionOrdersForGroup(this.orders, this.selectedGroup);
+    }
+
+    get requiresProof() {
+        return Boolean(this.selectedGroup?.requiresPod);
+    }
+
+    get summary() {
+        const states = Object.values(this.results).map((result) => result.state);
+        const count = (state) => states.filter((candidate) => candidate === state).length;
+        const updated = count('updated');
+        const failed = count('failed');
+        const skipped = count('skipped');
+
+        return { total: states.length - skipped, updated, failed, skipped, finished: updated + failed };
+    }
+
+    get runPercent() {
+        const { finished, total } = this.summary;
+        return percentOf(finished, total);
+    }
+
+    get resultRows() {
+        return this.orders
+            .filter((order) => this.results[order.id])
+            .map((order) => {
+                const { state, error } = this.results[order.id];
+
+                return {
+                    order,
+                    state,
+                    error,
+                    label: this.intl.t(`modals.bulk-order-activity.state-${state}`),
+                    stateClass: STATE_CLASSES[state],
+                };
+            });
+    }
+
+    @action selectActivity(key) {
+        this.selectedKey = key;
+        this.bypassProof = false;
+        this.syncAcceptButton();
+    }
+
+    @action toggleBypassProof(value) {
+        this.bypassProof = value;
+    }
+
+    /**
+     * Names how many orders the accept button will update, and disables it until an
+     * activity is chosen. Never called while the modal first renders: the opening
+     * options already start it disabled.
+     */
+    syncAcceptButton() {
+        const count = this.plan.targets.length;
+
+        this.modalsManager.setOptions({
+            acceptButtonDisabled: count === 0,
+            acceptButtonText: count > 0 ? this.intl.t('modals.bulk-order-activity.apply-to', { count }) : this.intl.t('modals.bulk-order-activity.apply'),
+        });
+    }
+
+    @task *loadOptions() {
+        const hadSelection = this.selectedKey !== null;
+
+        this.optionsByOrderId = {};
+        this.selectedKey = null;
+        this.bypassProof = false;
+
+        if (hadSelection) {
+            this.syncAcceptButton();
+        }
+
+        yield all(this.orders.map((order) => this.loadOrderOptions.perform(order)));
+    }
+
+    @task({ enqueue: true, maxConcurrency: CONCURRENCY }) *loadOrderOptions(order) {
+        let entry;
+
+        try {
+            const activities = yield this.fetch.get(`orders/next-activity/${order.id}`);
+            entry = { activities: Array.isArray(activities) ? activities : [], error: null };
+        } catch (error) {
+            entry = { activities: [], error: describeError(error) };
+        }
+
+        this.optionsByOrderId = { ...this.optionsByOrderId, [order.id]: entry };
+    }
+
+    @task({ drop: true }) *confirm(modal) {
+        if (this.phase === 'done') {
+            return modal.done();
+        }
+
+        if (this.phase !== 'select' || this.loadOptions.isRunning) {
+            return;
+        }
+
+        if (!this.selectedKey) {
+            return this.notifications.warning(this.intl.t('modals.bulk-order-activity.select-warning'));
+        }
+
+        if (this.isCustom && !isUsableCustomActivity(this.customActivity)) {
+            return this.notifications.warning(this.intl.t('modals.bulk-order-activity.custom-invalid'));
+        }
+
+        if (this.requiresProof && !this.bypassProof) {
+            return this.notifications.warning(this.intl.t('modals.bulk-order-activity.proof-warning'));
+        }
+
+        const { targets, skipped } = this.plan;
+        if (targets.length === 0) {
+            return this.notifications.warning(this.intl.t('modals.bulk-order-activity.no-targets'));
+        }
+
+        this.results = Object.fromEntries([
+            ...targets.map(({ order }) => [order.id, { state: 'pending', error: null }]),
+            ...skipped.map((order) => [order.id, { state: 'skipped', error: null }]),
+        ]);
+        this.phase = 'running';
+        this.hasStarted = true;
+        modal.startLoading();
+
+        yield all(targets.map((target) => this.updateOrder.perform(target)));
+
+        this.phase = 'done';
+        modal.stopLoading();
+        modal.setOptions({
+            acceptButtonText: this.intl.t('common.done'),
+            acceptButtonIcon: 'check',
+            hideDeclineButton: true,
+        });
+        this.notifySummary();
+    }
+
+    @task({ enqueue: true, maxConcurrency: CONCURRENCY }) *updateOrder({ order, activity }) {
+        this.setResult(order.id, { state: 'updating', error: null });
+
+        try {
+            yield this.fetch.patch(`orders/update-activity/${order.id}`, {
+                activity,
+                proof: null,
+                bypass_proof: Boolean(activity?.require_pod) && this.bypassProof,
+            });
+            this.setResult(order.id, { state: 'updated', error: null });
+        } catch (error) {
+            this.setResult(order.id, { state: 'failed', error: describeError(error) });
+        }
+    }
+
+    setResult(orderId, result) {
+        this.results = { ...this.results, [orderId]: result };
+    }
+
+    notifySummary() {
+        const { updated, failed, skipped } = this.summary;
+
+        if (failed === 0 && skipped === 0) {
+            return this.notifications.success(this.intl.t('modals.bulk-order-activity.all-updated', { count: updated }));
+        }
+
+        return this.notifications.warning(this.intl.t('modals.bulk-order-activity.summary', { updated, failed, skipped }));
+    }
+}
+
+function percentOf(part, total) {
+    return total > 0 ? Math.round((part / total) * 100) : 0;
+}
