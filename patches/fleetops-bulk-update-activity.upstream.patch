+import Service from '@ember/service';
+import { set, setProperties } from '@ember/object';
+import { module, test } from 'qunit';
+import { setupRenderingTest } from 'dummy/tests/helpers';
+import { render, click, fillIn, findAll, find, waitUntil, clearRender, settled } from '@ember/test-helpers';
+import { setupIntl } from 'ember-intl/test-support';
+import { hbs } from 'ember-cli-htmlbars';
+
+const arrived = (id) => ({ code: 'arrived', status: 'Arrived', details: 'Arrived at pickup', _resolved_status: `Arrived at ${id}` });
+const enroute = { code: 'enroute', status: 'En Route', details: 'Driver is en route' };
+
+class FetchStub extends Service {
+    nextActivity = {};
+    patchErrors = {};
+    patches = [];
+    inFlight = 0;
+    maxInFlight = 0;
+    holdPatches = false;
+    held = [];
+
+    get(path) {
+        const value = this.nextActivity[path.replace('orders/next-activity/', '')];
+        return value instanceof Error ? Promise.reject(value) : Promise.resolve(value ?? []);
+    }
+
+    patch(path, body) {
+        const id = path.replace('orders/update-activity/', '');
+        this.patches.push({ id, body });
+        this.inFlight++;
+        this.maxInFlight = Math.max(this.maxInFlight, this.inFlight);
+
+        const settle = () => {
+            this.inFlight--;
+            return this.patchErrors[id] ? Promise.reject(this.patchErrors[id]) : Promise.resolve({});
+        };
+
+        return this.holdPatches ? new Promise((resolve) => this.held.push(resolve)).then(settle) : Promise.resolve().then(settle);
+    }
+
+    release() {
+        const held = this.held;
+        this.held = [];
+        held.forEach((resolve) => resolve());
+    }
+}
+
+class NotificationsStub extends Service {
+    warnings = [];
+    successes = [];
+
+    warning(message) {
+        this.warnings.push(message);
+    }
+
+    success(message) {
+        this.successes.push(message);
+    }
+
+    serverError() {}
+}
+
+/** Applies option changes to the same object the modal renders from, as the real manager does. */
+class ModalsManagerStub extends Service {
+    modals = [];
+    calls = [];
+    options = null;
+
+    setOption(key, value) {
+        set(this.options, key, value);
+    }
+
+    setOptions(values) {
+        setProperties(this.options, values);
+    }
+
+    startLoading() {
+        this.calls.push('startLoading');
+        this.setOption('isLoading', true);
+    }
+
+    stopLoading() {
+        this.calls.push('stopLoading');
+        this.setOption('isLoading', false);
+    }
+
+    done() {
+        this.calls.push('done');
+        return Promise.resolve();
+    }
+}
+
+const acceptButton = () => {
+    const buttons = findAll('.modal-footer-actions button');
+    return buttons[buttons.length - 1];
+};
+
+const optionsLoaded = () => waitUntil(() => !find('[data-test-bulk-order-activity-loading]') && find('[data-test-bulk-order-activity-option="custom"]'));
+const runFinished = () => waitUntil(() => find('[data-test-bulk-order-activity-row]') && !find('[data-test-state="pending"], [data-test-state="updating"]'));
+
+module('Integration | Component | modals/bulk-update-order-activity', function (hooks) {
+    setupRenderingTest(hooks);
+    setupIntl(hooks, 'en-us');
+
+    hooks.beforeEach(function () {
+        this.owner.register('service:fetch', FetchStub);
+        this.owner.register('service:notifications', NotificationsStub);
+        this.owner.register('service:modals-manager', ModalsManagerStub);
+
+        this.fetch = this.owner.lookup('service:fetch');
+        this.notifications = this.owner.lookup('service:notifications');
+        this.modalsManager = this.owner.lookup('service:modals-manager');
+        this.finished = [];
+
+        this.open = async (orders) => {
+            this.set('options', {
+                title: 'Update Activity',
+                acceptButtonText: 'Apply Activity',
+                acceptButtonDisabled: true,
+                orders,
+                onFinished: (summary) => this.finished.push(summary),
+            });
+            this.modalsManager.options = this.options;
+
+            await render(hbs`<Modals::BulkUpdateOrderActivity @options={{this.options}} @modalIsOpened={{true}} />`);
+            await optionsLoaded();
+        };
+
+        this.orders = [
+            { id: 'o1', public_id: 'O-1' },
+            { id: 'o2', public_id: 'O-2' },
+            { id: 'o3', public_id: 'O-3' },
+        ];
+    });
+
+    test('it groups each order’s next activities and says how many orders each one applies to', async function (assert) {
+        this.fetch.nextActivity = { o1: [arrived('o1'), enroute], o2: [arrived('o2')], o3: new Error('Order not found.') };
+
+        await this.open(this.orders);
+
+        assert.dom('[data-test-bulk-order-activity-option]').exists({ count: 3 }, 'arrived, en route and the custom activity');
+        assert.dom('[data-test-bulk-order-activity-option="code:arrived"] [data-test-bulk-order-activity-count]').hasText('Available for 2 of 3 orders');
+        assert.dom('[data-test-bulk-order-activity-option="code:enroute"] [data-test-bulk-order-activity-count]').hasText('Available for 1 of 3 orders');
+        assert.dom('[data-test-bulk-order-activity-load-failures]').includesText('O-3').includesText('Order not found.');
+        assert.dom(acceptButton()).isDisabled('nothing to apply until an activity is chosen');
+
+        await click('[data-test-bulk-order-activity-option="code:arrived"] input[type="radio"]');
+
+        assert.dom('[data-test-bulk-order-activity-skipped]').includesText('1 order will be skipped').includesText('O-3');
+        assert.dom(acceptButton()).isNotDisabled().hasText('Apply to 2 Orders');
+
+        await clearRender();
+        assert.deepEqual(this.finished, [], 'closing before anything was sent does not refresh the table');
+    });
+
+    test('it sends every order its own activity record and reports each order’s outcome', async function (assert) {
+        this.fetch.nextActivity = { o1: [arrived('o1')], o2: [arrived('o2')], o3: [enroute] };
+        this.fetch.patchErrors = { o2: new Error('No driver assigned for order to dispatch to.') };
+
+        await this.open(this.orders);
+        await click('[data-test-bulk-order-activity-option="code:arrived"] input[type="radio"]');
+        await click(acceptButton());
+        await runFinished();
+
+        assert.deepEqual(
+            this.fetch.patches.map(({ id, body }) => [id, body.activity._resolved_status, body.proof, body.bypass_proof]),
+            [
+                ['o1', 'Arrived at o1', null, false],
+                ['o2', 'Arrived at o2', null, false],
+            ],
+            'o3 does not offer the activity and is not sent it'
+        );
+        assert.dom('[data-test-bulk-order-activity-row="o1"]').hasAttribute('data-test-state', 'updated').includesText('Updated');
+        assert.dom('[data-test-bulk-order-activity-row="o2"]').hasAttribute('data-test-state', 'failed');
+        assert.dom('[data-test-bulk-order-activity-row="o2"] [data-test-bulk-order-activity-error]').hasText('No driver assigned for order to dispatch to.');
+        assert.dom('[data-test-bulk-order-activity-row="o3"]').hasAttribute('data-test-state', 'skipped');
+        assert.dom('[data-test-bulk-order-activity-summary]').hasText('1 updated, 1 failed, 1 skipped');
+        assert.deepEqual(this.notifications.warnings, ['1 updated, 1 failed, 1 skipped']);
+        assert.dom(acceptButton()).hasText('Done');
+
+        await click(acceptButton());
+        assert.deepEqual(this.modalsManager.calls, ['startLoading', 'stopLoading', 'done']);
+
+        await clearRender();
+        assert.deepEqual(this.finished, [{ total: 2, updated: 1, failed: 1, skipped: 1, finished: 2 }], 'the table is refreshed once the modal closes');
+    });
+
+    test('it says so when every order was updated', async function (assert) {
+        this.fetch.nextActivity = { o1: [arrived('o1')], o2: [arrived('o2')] };
+
+        await this.open(this.orders.slice(0, 2));
+        await click('[data-test-bulk-order-activity-option="code:arrived"] input[type="radio"]');
+        await click(acceptButton());
+        await runFinished();
+
+        assert.deepEqual(this.notifications.successes, ['2 orders updated.']);
+        assert.deepEqual(this.notifications.warnings, []);
+    });
+
+    test('an activity that needs photo proof is only sent once proof is bypassed, and only flags the orders that need it', async function (assert) {
+        this.fetch.nextActivity = {
+            o1: [{ code: 'completed', status: 'Completed', require_pod: true }],
+            o2: [{ code: 'completed', status: 'Completed' }],
+        };
+
+        await this.open(this.orders.slice(0, 2));
+        await click('[data-test-bulk-order-activity-option="code:completed"] input[type="radio"]');
+
+        assert.dom('[data-test-bulk-order-activity-proof]').exists();
+
+        await click(acceptButton());
+        assert.strictEqual(this.fetch.patches.length, 0, 'nothing is sent without proof or a bypass');
+        assert.deepEqual(this.notifications.warnings, ['Turn on bypass proof of delivery, or update these orders one at a time to upload photo proof.']);
+
+        await click('[data-test-bulk-order-activity-proof] [role="checkbox"]');
+        await click(acceptButton());
+        await runFinished();
+
+        assert.deepEqual(
+            this.fetch.patches.map(({ id, body }) => [id, body.bypass_proof]),
+            [
+                ['o1', true],
+                ['o2', false],
+            ]
+        );
+    });
+
+    test('a custom activity needs content and then goes to every order, even one whose options failed to load', async function (assert) {
+        this.fetch.nextActivity = { o1: [arrived('o1')], o2: [], o3: new Error('Order not found.') };
+
+        await this.open(this.orders);
+        await click('[data-test-bulk-order-activity-option="custom"] input[type="radio"]');
+        assert.dom(acceptButton()).hasText('Apply to 3 Orders');
+
+        await click(acceptButton());
+        assert.strictEqual(this.fetch.patches.length, 0);
+        assert.deepEqual(this.notifications.warnings, ['Enter a status, details or code for the custom activity.']);
+
+        const [statusInput] = findAll('[data-test-bulk-order-activity-option="custom"] input[type="text"]');
+        await fillIn(statusInput, 'Held at depot');
+        await click(acceptButton());
+        await runFinished();
+
+        assert.deepEqual(
+            this.fetch.patches.map(({ id, body }) => [id, body.activity.status]),
+            [
+                ['o1', 'Held at depot'],
+                ['o2', 'Held at depot'],
+                ['o3', 'Held at depot'],
+            ]
+        );
+    });
+
+    test('it sends at most five updates at once, and closing part way stops the rest', async function (assert) {
+        const orders = Array.from({ length: 7 }, (_, index) => ({ id: `o${index + 1}`, public_id: `O-${index + 1}` }));
+        this.fetch.nextActivity = Object.fromEntries(orders.map(({ id }) => [id, [arrived(id)]]));
+        this.fetch.holdPatches = true;
+
+        await this.open(orders);
+        await click('[data-test-bulk-order-activity-option="code:arrived"] input[type="radio"]');
+        await click(acceptButton());
+        await waitUntil(() => this.fetch.patches.length === 5);
+
+        assert.strictEqual(this.fetch.maxInFlight, 5);
+        assert.dom('[data-test-state="updating"]').exists({ count: 5 });
+        assert.dom('[data-test-state="pending"]').exists({ count: 2 });
+
+        await clearRender();
+        this.fetch.release();
+        await settled();
+
+        assert.strictEqual(this.fetch.patches.length, 5, 'the two queued updates are never sent');
+        assert.deepEqual(this.notifications.warnings, ['Bulk activity update stopped after 0 of 7 orders. Updates already sent may still complete.']);
+        assert.deepEqual(this.finished, [{ total: 7, updated: 0, failed: 0, skipped: 0, finished: 0 }]);
+    });
+});
diff --git a/tests/node/bulk-order-activity.test.mjs b/tests/node/bulk-order-activity.test.mjs
