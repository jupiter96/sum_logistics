+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { activityKey, uniqueById, groupActivityOptions, partitionOrdersForGroup, isUsableCustomActivity, describeError } from '../../addon/utils/bulk-order-activity.js';
+
+const arrived = (order) => ({ code: 'arrived', status: 'Arrived', _resolved_status: `Arrived at ${order}` });
+const enroute = { code: 'enroute', status: 'En Route' };
+const completed = { code: 'completed', status: 'Completed', require_pod: true };
+
+test('activities are the same across orders when their code matches, or their status when there is no code', () => {
+    assert.equal(activityKey({ code: ' arrived ', status: 'Arrived' }), 'code:arrived');
+    assert.equal(activityKey({ status: ' At Gate ' }), 'status:at gate');
+    assert.equal(activityKey({ code: '', status: '' }), null);
+    assert.equal(activityKey(null), null);
+});
+
+test('uniqueById keeps the first record per id and drops records without one', () => {
+    const a = { id: 'order_1' };
+    const b = { id: 'order_2' };
+
+    assert.deepEqual(uniqueById([a, b, { id: 'order_1' }, { id: '' }, null, {}]), [a, b]);
+    assert.deepEqual(uniqueById(undefined), []);
+});
+
+test('options are grouped by activity, most widely available first, keeping each order its own record', () => {
+    const groups = groupActivityOptions([
+        { id: 'order_1', activities: [enroute, arrived('order_1')] },
+        { id: 'order_2', activities: [arrived('order_2'), completed] },
+        { id: 'order_3', activities: [arrived('order_3')] },
+        { id: 'order_4', activities: undefined },
+    ]);
+
+    assert.deepEqual(
+        groups.map(({ key, count }) => [key, count]),
+        [
+            ['code:arrived', 3],
+            ['code:enroute', 1],
+            ['code:completed', 1],
+        ]
+    );
+
+    const [arrivedGroup] = groups;
+    assert.deepEqual(arrivedGroup.orderIds, ['order_1', 'order_2', 'order_3']);
+    assert.equal(arrivedGroup.activitiesByOrderId.get('order_2')._resolved_status, 'Arrived at order_2');
+    assert.equal(arrivedGroup.activity._resolved_status, 'Arrived at order_1');
+    assert.equal(arrivedGroup.requiresPod, false);
+    assert.equal(groups[2].requiresPod, true);
+});
+
+test('an order listing the same activity twice counts once, and its first record wins', () => {
+    const first = { code: 'arrived', status: 'Arrived', details: 'first' };
+    const [group] = groupActivityOptions([{ id: 'order_1', activities: [first, { code: 'arrived', status: 'Arrived', details: 'second' }] }]);
+
+    assert.equal(group.count, 1);
+    assert.equal(group.activitiesByOrderId.get('order_1'), first);
+});
+
+test('proof is required for a group when any order needs it for that activity', () => {
+    const [group] = groupActivityOptions([
+        { id: 'order_1', activities: [{ code: 'completed', status: 'Completed' }] },
+        { id: 'order_2', activities: [{ code: 'completed', status: 'Completed', require_pod: true }] },
+    ]);
+
+    assert.equal(group.requiresPod, true);
+});
+
+test('a group applies to the orders that offer it, each with its own record, and skips the rest', () => {
+    const orders = [{ id: 'order_1' }, { id: 'order_2' }, { id: 'order_3' }];
+    const [group] = groupActivityOptions([
+        { id: 'order_1', activities: [arrived('order_1')] },
+        { id: 'order_3', activities: [arrived('order_3')] },
+    ]);
+
+    const { targets, skipped } = partitionOrdersForGroup(orders, group);
+    assert.deepEqual(
+        targets.map(({ order, activity }) => [order.id, activity._resolved_status]),
+        [
+            ['order_1', 'Arrived at order_1'],
+            ['order_3', 'Arrived at order_3'],
+        ]
+    );
+    assert.deepEqual(skipped, [orders[1]]);
+
+    assert.deepEqual(partitionOrdersForGroup(orders, null), { targets: [], skipped: orders });
+});
+
+test('a custom activity needs a status, details or code', () => {
+    assert.equal(isUsableCustomActivity({}), false);
+    assert.equal(isUsableCustomActivity({ status: '   ', details: '' }), false);
+    assert.equal(isUsableCustomActivity({ code: 'held_at_depot' }), true);
+    assert.equal(isUsableCustomActivity({ details: 'Waiting for dock' }), true);
+});
+
+test('a failed update shows the server message the way serverError() reads it', () => {
+    assert.equal(describeError({ errors: ['This activity is not a permitted next step for the order.'] }), 'This activity is not a permitted next step for the order.');
+    assert.equal(describeError(new Error('No driver assigned for order to dispatch to.')), 'No driver assigned for order to dispatch to.');
+    assert.equal(describeError('Network error'), 'Network error');
+    assert.equal(describeError({ message: 'Proof of delivery is required.' }), 'Proof of delivery is required.');
+    assert.equal(describeError({ errors: [] }, 'Fallback'), 'Fallback');
+    assert.equal(describeError(undefined), 'Request failed.');
+});
