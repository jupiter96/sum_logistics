diff --git a/addon/utils/bulk-order-activity.js b/addon/utils/bulk-order-activity.js
new file mode 100644
index 0000000..0d980da
--- /dev/null
+++ b/addon/utils/bulk-order-activity.js
@@ -0,0 +1,163 @@
+/**
+ * Helpers for applying one activity to many orders at once.
+ *
+ * Each order only offers the activities its own order flow allows next (from
+ * `orders/next-activity/{id}`), so a bulk update cannot show one fixed list. These
+ * helpers group the per-order options into "the same activity" across orders and
+ * work out which orders a chosen activity applies to. They are plain functions with
+ * no Ember imports so they can be unit tested on their own.
+ */
+
+/**
+ * The key that identifies the same activity across orders: its code, or its status
+ * when an activity has no code. Returns null for an activity with neither.
+ *
+ * @param {Object} activity
+ * @return {String|null}
+ */
+export function activityKey(activity) {
+    const code = typeof activity?.code === 'string' ? activity.code.trim() : '';
+    if (code) {
+        return `code:${code}`;
+    }
+
+    const status = typeof activity?.status === 'string' ? activity.status.trim().toLowerCase() : '';
+    return status ? `status:${status}` : null;
+}
+
+/**
+ * Drops records whose id was already seen, keeping the first. Records without an id
+ * are dropped too: an activity update cannot be sent for them.
+ *
+ * @param {Array} records
+ * @return {Array}
+ */
+export function uniqueById(records = []) {
+    const seen = new Set();
+
+    return (Array.isArray(records) ? records : []).filter((record) => {
+        const id = record?.id;
+        if (id === undefined || id === null || id === '' || seen.has(id)) {
+            return false;
+        }
+
+        seen.add(id);
+        return true;
+    });
+}
+
+/**
+ * Groups the next activities of several orders by activityKey().
+ *
+ * Every group keeps each order's own activity record, because the server resolves
+ * templated status and details per order and, for configs without strict
+ * transitions, stores the record it is sent.
+ *
+ * Groups available to the most orders come first; ties keep the order in which the
+ * activities were first seen.
+ *
+ * @param {Array<{id: String, activities: Array}>} entries one entry per order
+ * @return {Array<{key: String, activity: Object, count: Number, orderIds: Array<String>, activitiesByOrderId: Map, requiresPod: Boolean}>}
+ */
+export function groupActivityOptions(entries = []) {
+    const groups = new Map();
+
+    (Array.isArray(entries) ? entries : []).forEach((entry) => {
+        const activities = Array.isArray(entry?.activities) ? entry.activities : [];
+
+        activities.forEach((activity) => {
+            const key = activityKey(activity);
+            if (!key) {
+                return;
+            }
+
+            if (!groups.has(key)) {
+                groups.set(key, { key, activity, position: groups.size, activitiesByOrderId: new Map() });
+            }
+
+            const group = groups.get(key);
+            if (!group.activitiesByOrderId.has(entry.id)) {
+                group.activitiesByOrderId.set(entry.id, activity);
+            }
+        });
+    });
+
+    return [...groups.values()]
+        .sort((a, b) => b.activitiesByOrderId.size - a.activitiesByOrderId.size || a.position - b.position)
+        .map(({ key, activity, activitiesByOrderId }) => {
+            const perOrder = [...activitiesByOrderId.values()];
+
+            return {
+                key,
+                activity,
+                count: activitiesByOrderId.size,
+                orderIds: [...activitiesByOrderId.keys()],
+                activitiesByOrderId,
+                requiresPod: perOrder.some((candidate) => Boolean(candidate?.require_pod)),
+            };
+        });
+}
+
+/**
+ * Splits orders into those a group applies to, each paired with its own activity
+ * record, and those it does not.
+ *
+ * @param {Array} orders
+ * @param {Object|null} group a group from groupActivityOptions()
+ * @return {{targets: Array<{order: Object, activity: Object}>, skipped: Array}}
+ */
+export function partitionOrdersForGroup(orders = [], group = null) {
+    const targets = [];
+    const skipped = [];
+
+    (Array.isArray(orders) ? orders : []).forEach((order) => {
+        const activity = group?.activitiesByOrderId?.get(order?.id);
+
+        if (activity) {
+            targets.push({ order, activity });
+        } else {
+            skipped.push(order);
+        }
+    });
+
+    return { targets, skipped };
+}
+
+/**
+ * The message to show for a failed request, read the way notifications.serverError()
+ * reads it: an `errors` array, then an Error's message, then a plain string.
+ *
+ * @param {*} error
+ * @param {String} fallback
+ * @return {String}
+ */
+export function describeError(error, fallback = 'Request failed.') {
+    if (Array.isArray(error?.errors) && typeof error.errors[0] === 'string' && error.errors[0] !== '') {
+        return error.errors[0];
+    }
+
+    if (error instanceof Error && error.message) {
+        return error.message;
+    }
+
+    if (typeof error === 'string' && error !== '') {
+        return error;
+    }
+
+    if (typeof error?.message === 'string' && error.message !== '') {
+        return error.message;
+    }
+
+    return fallback;
+}
+
+/**
+ * Whether a custom activity has enough to be sent: the same rule as the single-order
+ * activity modal (a status, details or code).
+ *
+ * @param {Object} activity
+ * @return {Boolean}
+ */
+export function isUsableCustomActivity(activity) {
+    return ['status', 'details', 'code'].some((field) => typeof activity?.[field] === 'string' && activity[field].trim() !== '');
+}
