+                }
+            );
+            this.owner.register(
+                'service:table-context',
+                class extends Service {
+                    selected = [];
+                    untoggled = 0;
+
+                    getSelectedRows() {
+                        return this.selected;
+                    }
+
+                    untoggleSelectAll() {
+                        this.untoggled++;
+                    }
+                }
+            );
+            this.owner.register(
+                'service:host-router',
+                class extends Service {
+                    refreshed = 0;
+
+                    refresh() {
+                        this.refreshed++;
+                        return Promise.resolve();
+                    }
+                }
+            );
+
+            this.tableContext = this.owner.lookup('service:table-context');
+            this.service = this.owner.lookup('service:order-actions');
+        });
+
+        test('it opens the bulk activity modal for the selected orders, each once', async function (assert) {
+            const first = { id: 'order_1' };
+            const second = { id: 'order_2' };
+            this.tableContext.selected = [first, second];
+
+            this.service.bulkUpdateActivity([first]);
+
+            assert.strictEqual(this.shown.length, 1);
+            const [{ template, options }] = this.shown;
+            assert.strictEqual(template, 'modals/bulk-update-order-activity');
+            assert.deepEqual(options.orders, [first, second], 'an order passed in and also selected is sent one request, not two');
+            assert.strictEqual(options.title, 'Update Activity for 2 Orders');
+            assert.true(options.acceptButtonDisabled, 'nothing to apply until an activity is chosen');
+
+            await options.onFinished({ updated: 2 });
+            assert.strictEqual(this.tableContext.untoggled, 1, 'the selection is cleared');
+            assert.strictEqual(this.owner.lookup('service:host-router').refreshed, 1, 'the table is refreshed');
+        });
+
+        test('the bulk actions menu passes a click event, which is not a selection; with no rows selected nothing opens', function (assert) {
+            this.service.bulkUpdateActivity(new Event('click'));
+
+            assert.strictEqual(this.shown.length, 0);
+        });
+    });
 });
