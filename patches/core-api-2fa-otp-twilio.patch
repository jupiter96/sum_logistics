diff --git a/tests/Unit/Support/TwoFactorAuthTest.php b/tests/Unit/Support/TwoFactorAuthTest.php
index 77a5163..c312cdd 100644
--- a/tests/Unit/Support/TwoFactorAuthTest.php
+++ b/tests/Unit/Support/TwoFactorAuthTest.php
@@ -882,3 +882,50 @@ test('two factor auth rejects a pending authenticator challenge after its user i
 
     expect(fn () => TwoFactorAuth::verifyCode('123456', $token, $clientToken))->toThrow(Exception::class, 'Verification code is invalid.');
 });
+
+test('two factor auth sent codes expire with the client token the console counts down', function () {
+    [$user] = two_factor_auth_fixtures();
+    $twilio = new TwoFactorAuthTwilioFake();
+
+    app()->instance('twilio', $twilio);
+    Facade::clearResolvedInstance('twilio');
+    config(['sms.default_provider' => SmsService::PROVIDER_TWILIO, 'sms.routing_rules' => []]);
+    Carbon::setTestNow(Carbon::parse('2026-11-19 10:00:00', 'UTC'));
+    $expiresAt = Carbon::now()->addSeconds(TwoFactorAuth::CODE_TTL);
+
+    foreach (['sms', 'email'] as $method) {
+        TwoFactorAuth::saveTwoFaSettingsForUser($user, ['enabled' => true, 'method' => $method]);
+
+        $verificationCode = TwoFactorAuth::sendVerificationCode($user);
+        $clientToken      = TwoFactorAuth::createClientSessionToken($verificationCode);
+
+        expect(Carbon::parse($verificationCode->expires_at)->equalTo($expiresAt))->toBeTrue("the {$method} code lasts CODE_TTL seconds, not an hour")
+            ->and(explode('|', base64_decode($clientToken))[0])->toBe('2026-11-19 10:05:00');
+    }
+});
+
+test('two factor auth texts sign-in codes through twilio whatever the sms routing says', function () {
+    [$user] = two_factor_auth_fixtures();
+    $twilio = new TwoFactorAuthTwilioFake();
+
+    app()->instance('twilio', $twilio);
+    Facade::clearResolvedInstance('twilio');
+    config([
+        'sms.default_provider' => SmsService::PROVIDER_VONAGE,
+        'sms.routing_rules'    => ['+1' => SmsService::PROVIDER_MESSAGEBIRD],
+        'sms.two_fa_provider'  => SmsService::PROVIDER_TWILIO,
+    ]);
+    TwoFactorAuth::saveTwoFaSettingsForUser($user, ['enabled' => true, 'method' => 'sms']);
+
+    $verificationCode = TwoFactorAuth::sendVerificationCode($user);
+
+    expect($twilio->messages)->toHaveCount(1)
+        ->and($twilio->messages[0]['to'])->toBe($user->phone)
+        ->and($twilio->messages[0]['message'])->toContain($verificationCode->code);
+
+    config(['sms.two_fa_provider' => '', 'sms.default_provider' => SmsService::PROVIDER_TWILIO, 'sms.routing_rules' => []]);
+    Carbon::setTestNow(Carbon::now()->addMinute());
+    TwoFactorAuth::sendVerificationCode($user);
+
+    expect($twilio->messages)->toHaveCount(2, 'an empty setting falls back to normal routing');
+});
