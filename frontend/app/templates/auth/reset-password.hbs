{{page-title (t "auth.reset-password.title")}}
{{#if this.isLinkInvalid}}
    <Auth::Card @icon="link-slash" @title={{t "auth.reset-password.invalid-link.title"}} @subtitle={{t "auth.reset-password.invalid-link.subtitle"}} data-test-reset-password-invalid>
        <div class="mt-6">
            <Button
                @icon="paper-plane"
                @type="primary"
                @wrapperClass="btn-block"
                @text={{t "auth.reset-password.invalid-link.request-new"}}
                @onClick={{transition-to "auth.forgot-password"}}
                data-test-request-new-link
            />
        </div>
        <div class="mt-5 text-center text-sm">
            <LinkTo
                @route="auth.login"
                class="font-medium text-blue-600 hover:text-blue-500 hover:underline focus:outline-none focus-visible:underline dark:text-blue-300 dark:hover:text-blue-200"
            >
                <FaIcon @icon="arrow-left" class="mr-1" />{{t "auth.forgot-password.back-to-login"}}
            </LinkTo>
        </div>
    </Auth::Card>
{{else}}
    <Auth::Card @icon="key" @brand={{@brand}} @title={{t "auth.reset-password.title"}} @subtitle={{t "auth.reset-password.subtitle"}} data-test-reset-password-form>
        <form class="mt-6 space-y-5" {{on "submit" (perform this.resetPassword)}}>
            {{#unless this.hasCodeFromLink}}
                <div>
                    <label for="reset-code" class="block text-sm font-medium text-gray-700 dark:text-gray-50">
                        {{t "auth.reset-password.form.code.label"}}
                    </label>
                    <Input
                        @value={{this.code}}
                        @type="text"
                        id="reset-code"
                        inputmode="numeric"
                        autocomplete="one-time-code"
                        required
                        class="form-input form-input-lg mt-2 w-full focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                        aria-describedby="reset-code-help"
                        data-test-code
                    />
                    <p id="reset-code-help" class="mt-1 text-xs text-gray-500 dark:text-gray-400">{{t "auth.reset-password.form.code.help-text"}}</p>
                </div>
            {{/unless}}

            <div>
                <div class="flex items-center justify-between">
                    <label for="new-password" class="block text-sm font-medium text-gray-700 dark:text-gray-50">
                        {{t "auth.reset-password.form.password.label"}}
                    </label>
                    <button
                        type="button"
                        class="text-xs font-medium text-blue-600 hover:text-blue-500 focus:outline-none focus-visible:underline dark:text-blue-300 dark:hover:text-blue-200"
                        aria-pressed={{if this.isPasswordVisible "true" "false"}}
                        {{on "click" this.togglePasswordVisibility}}
                        data-test-toggle-visibility
                    >
                        <FaIcon @icon={{if this.isPasswordVisible "eye-slash" "eye"}} class="mr-1" />{{if
                            this.isPasswordVisible
                            (t "auth.reset-password.form.hide-password")
                            (t "auth.reset-password.form.show-password")
                        }}
                    </button>
                </div>
                <Input
                    @value={{this.password}}
                    @type={{if this.isPasswordVisible "text" "password"}}
                    id="new-password"
                    autocomplete="new-password"
                    required
                    class="form-input form-input-lg mt-2 w-full focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                    aria-describedby="password-requirements"
                    data-test-password
                />
            </div>

            <div>
                <label for="confirm-password" class="block text-sm font-medium text-gray-700 dark:text-gray-50">
                    {{t "auth.reset-password.form.confirm-password.label"}}
                </label>
                <Input
                    @value={{this.password_confirmation}}
                    @type={{if this.isPasswordVisible "text" "password"}}
                    id="confirm-password"
                    autocomplete="new-password"
                    required
                    class="form-input form-input-lg mt-2 w-full focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                    data-test-password-confirmation
                />
            </div>

            <ul id="password-requirements" class="space-y-1.5 rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-xs leading-5 dark:border-blue-800 dark:bg-blue-900">
                {{#each this.requirements key="key" as |requirement|}}
                    <li
                        class="flex items-center {{if requirement.isMet 'font-medium text-green-700 dark:text-green-300' 'text-blue-900 dark:text-blue-100'}}"
                        data-test-requirement={{requirement.key}}
                        data-test-met={{if requirement.isMet "true" "false"}}
                    >
                        <FaIcon @icon={{if requirement.isMet "circle-check" "circle"}} class="mr-2 flex-shrink-0 {{unless requirement.isMet 'opacity-25'}}" />
                        <span>{{requirement.label}}</span>
                        <span class="sr-only">{{if requirement.isMet (t "auth.reset-password.requirements.met") (t "auth.reset-password.requirements.not-met")}}</span>
                    </li>
                {{/each}}
            </ul>

            <Button
                @icon="check"
                @type="primary"
                @buttonType="submit"
                @wrapperClass="btn-block"
                @text={{t "auth.reset-password.form.submit-button"}}
                @isLoading={{this.resetPassword.isRunning}}
                @disabled={{not this.isReady}}
                data-test-submit
            />
        </form>

        <div class="mt-5 text-center text-sm">
            <LinkTo
                @route="auth.login"
                class="font-medium text-blue-600 hover:text-blue-500 hover:underline focus:outline-none focus-visible:underline dark:text-blue-300 dark:hover:text-blue-200"
            >
                <FaIcon @icon="arrow-left" class="mr-1" />{{t "auth.forgot-password.back-to-login"}}
            </LinkTo>
        </div>
    </Auth::Card>
{{/if}}