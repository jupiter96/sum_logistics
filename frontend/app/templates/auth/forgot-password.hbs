{{page-title (t "auth.forgot-password.not-sent.title")}}
{{#if this.isSent}}
    <Auth::Card @icon="envelope-circle-check" @title={{t "auth.forgot-password.is-sent.title"}} @subtitle={{t "auth.forgot-password.is-sent.subtitle"}} data-test-forgot-password-sent>
        <p class="mt-2 break-all text-center text-sm font-semibold text-blue-700 dark:text-blue-200" data-test-sent-to>{{this.trimmedEmail}}</p>

        <ul class="mt-6 space-y-2 rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-sm leading-5 text-blue-900 dark:border-blue-800 dark:bg-blue-900 dark:text-blue-100">
            <li class="flex items-start"><FaIcon @icon="clock" class="mr-2.5 mt-1 w-4 flex-shrink-0" /><span>{{t "auth.forgot-password.is-sent.expires"}}</span></li>
            <li class="flex items-start"><FaIcon @icon="inbox" class="mr-2.5 mt-1 w-4 flex-shrink-0" /><span>{{t "auth.forgot-password.is-sent.check-spam"}}</span></li>
        </ul>

        <div class="mt-6 space-y-3">
            <Button
                @icon="arrow-left"
                @type="primary"
                @wrapperClass="btn-block"
                @text={{t "auth.forgot-password.back-to-login"}}
                @onClick={{transition-to "auth.login"}}
                data-test-back-to-login
            />
            <Button
                @icon="rotate-right"
                @wrapperClass="btn-block"
                @text={{if this.canResend (t "auth.forgot-password.resend") (t "auth.forgot-password.resend-in" time=this.resendCountdown)}}
                @isLoading={{this.sendSecureLink.isRunning}}
                @disabled={{not this.canResend}}
                @onClick={{perform this.sendSecureLink}}
                data-test-resend
            />
        </div>

        <div class="mt-5 text-center text-sm">
            <button
                type="button"
                class="font-medium text-blue-600 hover:text-blue-500 hover:underline focus:outline-none focus-visible:underline dark:text-blue-300 dark:hover:text-blue-200"
                {{on "click" this.changeEmail}}
                data-test-change-email
            >
                {{t "auth.forgot-password.change-email"}}
            </button>
        </div>
    </Auth::Card>
{{else}}
    <Auth::Card
        @icon="lock"
        @title={{t "auth.forgot-password.not-sent.title"}}
        @subtitle={{t "auth.forgot-password.not-sent.subtitle" appName=(t "app.name")}}
        data-test-forgot-password-form
    >
        <form class="mt-6 space-y-5" {{on "submit" (perform this.sendSecureLink)}}>
            <div>
                <label for="email" class="block text-sm font-medium text-gray-700 dark:text-gray-50">
                    {{t "auth.forgot-password.form.email-label"}}
                </label>
                <div class="mt-2">
                    <Input
                        @value={{this.email}}
                        @type="email"
                        id="email"
                        name="email"
                        autocomplete="username"
                        required
                        class="form-input form-input-lg w-full focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                        placeholder={{t "auth.forgot-password.form.email-label"}}
                        disabled={{this.sendSecureLink.isRunning}}
                    />
                </div>
            </div>

            {{! No @onClick: the form's submit event covers the click and Enter, and lets
                  the browser check the address first. }}
            <Button
                @icon="paper-plane"
                @type="primary"
                @buttonType="submit"
                @wrapperClass="btn-block"
                @text={{t "auth.forgot-password.form.submit-button"}}
                @isLoading={{this.sendSecureLink.isRunning}}
                data-test-send-link
            />
        </form>

        <div class="mt-5 text-center text-sm">
            <LinkTo
                @route="auth.login"
                class="font-medium text-blue-600 hover:text-blue-500 hover:underline focus:outline-none focus-visible:underline dark:text-blue-300 dark:hover:text-blue-200"
                data-test-back-to-login
            >
                <FaIcon @icon="arrow-left" class="mr-1" />{{t "auth.forgot-password.back-to-login"}}
            </LinkTo>
        </div>
    </Auth::Card>
{{/if}}